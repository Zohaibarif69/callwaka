# Get this from https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=

# Usually you won't need to change this
CALLE_BASE_URL=https://api.heycall-e.com

# Your deployed app's URL, e.g. https://callwaka.vercel.app
# Used to build the webhook_url CALL-E calls back with the terminal result.
# Leave unset for local dev — the /api/cron/check-due poller will pick up
# results instead.
APP_BASE_URL=

# Optional: protects /api/cron/check-due from being called by randoms.
# If set, Vercel Cron (or you) must send: Authorization: Bearer <value>
CRON_SECRET=

# Optional: override the SQLite file location (defaults to ./data/callwaka.db locally,
# /tmp/callwaka.db on Vercel)
DATABASE_PATH=

# Turso (libSQL) — for a database that survives Vercel redeploys.
# Leave both unset to use a local file automatically (identical code path,
# used by local dev and npm run test:state-machine — no Turso account needed).
# Set both once you have a Turso database to go to production:
#   1. turso db create callwaka
#   2. turso db show callwaka --url          -> TURSO_DATABASE_URL
#   3. turso db tokens create callwaka       -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
